# ==== Debian Science Image ====
ARG BASE_IMAGE=oaklight/texlive:base
FROM ${BASE_IMAGE}
ARG BASE_IMAGE

# Install additional packages for the science version.
# --no-install-recommends drops the optional Java tooling, mupdf-tools, and
# system Noto/IPA fonts. TeX fonts and CJK support are unaffected.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ghostscript \
        liblog-log4perl-perl \
        ruby \
        texlive-science \
        texlive-latex-extra \
        texlive-extra-utils \
        texlive-fonts-extra \
        texlive-fonts-recommended \
    && rm -rf /var/lib/apt/lists/*

# Multilingual support: European babel languages and Cyrillic/Arabic.
# Same package set and purpose as the Alpine science image; the Debian babel
# packages are split per language, so all six are listed explicitly.
# fontconfig + fonts-dejavu-core give xelatex/lualatex a Cyrillic-capable
# system font; fonts-hosny-amiri provides Amiri for Arabic.
# Installed size: about 95 MiB (measured on debian-science).
RUN apt-get update && apt-get install -y --no-install-recommends \
        texlive-lang-french \
        texlive-lang-german \
        texlive-lang-spanish \
        texlive-lang-italian \
        texlive-lang-cyrillic \
        texlive-lang-arabic \
        fontconfig \
        fonts-dejavu-core \
        fonts-hosny-amiri \
    && fc-cache -f \
    && rm -rf /var/lib/apt/lists/*

# OCI image metadata. CI overrides version and revision.
ARG VERSION=dev
ARG REVISION=unknown
LABEL org.opencontainers.image.title="oaklight/texlive debian-science" \
      org.opencontainers.image.description="Debian-based TeX Live science image (math, extra, fonts)" \
      org.opencontainers.image.source="https://github.com/Oaklight/texlive" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${REVISION}" \
      org.opencontainers.image.base.name="${BASE_IMAGE}"
