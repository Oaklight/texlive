# ==== Alpine Science Image ====
ARG BASE_IMAGE=oaklight/texlive:alpine-base
FROM ${BASE_IMAGE}
ARG BASE_IMAGE

# Optional: use a Chinese APK mirror (e.g., mirrors.tuna.tsinghua.edu.cn)
ARG APK_MIRROR
RUN if [ -n "$APK_MIRROR" ]; then \
        sed -i "s|dl-cdn.alpinelinux.org|${APK_MIRROR}|g" /etc/apk/repositories; \
    fi

# Install additional packages for the science version
RUN apk add --no-cache \
        texmf-dist-mathscience \
        texmf-dist-latexextra \
        texmf-dist-fontsextra \
        texmf-dist-fontsrecommended \
        texlive-binextra \
        texmf-dist-binextra

# Multilingual support: European babel languages and Cyrillic/Arabic.
#
# - langfrench/langgerman/langspanish/langitalian provide the babel language
#   files and hyphenation patterns (pdflatex and xelatex).
# - langcyrillic provides T2A encoding + Russian/Ukrainian babel support.
# - langarabic provides polyglossia's Arabic definitions and arabxetex.
# - fontconfig + font-dejavu give xelatex/lualatex a Cyrillic-capable system
#   font; font-noto-arabic provides Noto Sans Arabic for Arabic documents.
#
# Installed size: about 137 MiB uncompressed (measured on alpine-science).
RUN apk add --no-cache \
        texmf-dist-langfrench \
        texmf-dist-langgerman \
        texmf-dist-langspanish \
        texmf-dist-langitalian \
        texmf-dist-langcyrillic \
        texmf-dist-langarabic \
        fontconfig \
        font-dejavu \
        font-noto-arabic \
    && fc-cache -f

# OCI image metadata. CI overrides version and revision.
ARG VERSION=dev
ARG REVISION=unknown
LABEL org.opencontainers.image.title="oaklight/texlive alpine-science" \
      org.opencontainers.image.description="Alpine-based TeX Live science image (math, extra, fonts)" \
      org.opencontainers.image.source="https://github.com/Oaklight/texlive" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${REVISION}" \
      org.opencontainers.image.base.name="${BASE_IMAGE}"
