# ==== Debian Base Image ====
FROM debian:trixie-slim AS base

# Install required packages for the base version
RUN apt-get update && apt-get install -y --no-install-recommends \
        biber \
        latexmk \
        make \
        texlive-bibtex-extra \
        texlive-fonts-recommended \
        texlive-plain-generic \
        texlive-luatex \
        texlive-xetex \
    && rm -rf /var/lib/apt/lists/*

# Copy the tex-fmt binary for the target platform.
ARG TEX_FMT_DIR=linux
ARG TARGETARCH
COPY ${TEX_FMT_DIR}/ /tmp/tex-fmt/
RUN case "${TARGETARCH}" in \
        amd64) cp /tmp/tex-fmt/amd64/tex-fmt /usr/local/bin/tex-fmt ;; \
        arm64) cp /tmp/tex-fmt/arm64/tex-fmt /usr/local/bin/tex-fmt ;; \
        *) echo "Unsupported architecture: ${TARGETARCH}" >&2; exit 1 ;; \
    esac \
    && chmod +x /usr/local/bin/tex-fmt \
    && rm -rf /tmp/tex-fmt

# OCI image metadata. CI overrides version and revision.
ARG VERSION=dev
ARG REVISION=unknown
LABEL org.opencontainers.image.title="oaklight/texlive debian-base" \
      org.opencontainers.image.description="Debian-based TeX Live base image (LuaTeX, XeTeX, biber)" \
      org.opencontainers.image.source="https://github.com/Oaklight/texlive" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${REVISION}"
# base.name is omitted: the FROM tag is the source of truth.
