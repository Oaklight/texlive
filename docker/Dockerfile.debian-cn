# ==== Debian Chinese Language Support ====
ARG BASE_IMAGE=oaklight/texlive:base
FROM ${BASE_IMAGE}
ARG BASE_IMAGE

# Chinese support: ctex, xeCJK, CJKutf8, fonts
# Also install lang-japanese for luatexja (required by ctex when using lualatex)
RUN apt-get update && apt-get install -y --no-install-recommends \
        texlive-lang-chinese \
        texlive-lang-japanese \
    && rm -rf /var/lib/apt/lists/*

# OCI image metadata. CI overrides version and revision.
ARG VERSION=dev
ARG REVISION=unknown
LABEL org.opencontainers.image.title="oaklight/texlive debian-science-cn" \
      org.opencontainers.image.description="Debian-based TeX Live science image with Chinese support" \
      org.opencontainers.image.source="https://github.com/Oaklight/texlive" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${REVISION}" \
      org.opencontainers.image.base.name="${BASE_IMAGE}"
