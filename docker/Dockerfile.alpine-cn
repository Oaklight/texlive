# ==== Alpine Chinese Language Support ====
ARG BASE_IMAGE=oaklight/texlive:alpine-base
FROM ${BASE_IMAGE}
ARG BASE_IMAGE

# Optional: use a Chinese APK mirror (e.g., mirrors.tuna.tsinghua.edu.cn)
ARG APK_MIRROR
RUN if [ -n "$APK_MIRROR" ]; then \
        sed -i "s|dl-cdn.alpinelinux.org|${APK_MIRROR}|g" /etc/apk/repositories; \
    fi

# Chinese support: ctex, xeCJK, CJKutf8, Fandol/arphic fonts
# Also install langjapanese for luatexja (required by ctex when using lualatex)
RUN apk add --no-cache \
        texmf-dist-langchinese \
        texmf-dist-langcjk \
        texmf-dist-langjapanese

# OCI image metadata. CI overrides version and revision.
ARG VERSION=dev
ARG REVISION=unknown
LABEL org.opencontainers.image.title="oaklight/texlive alpine-science-cn" \
      org.opencontainers.image.description="Alpine-based TeX Live science image with Chinese support" \
      org.opencontainers.image.source="https://github.com/Oaklight/texlive" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${REVISION}" \
      org.opencontainers.image.base.name="${BASE_IMAGE}"
