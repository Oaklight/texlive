# ==== Alpine Base Image ====
# Digest pinning: the tag states the release line, the digest makes the build
# reproducible. Dependabot (.github/dependabot.yml) updates both. To bump by
# hand: docker buildx imagetools inspect alpine:3.24
#
# A registry mirror cannot be injected through a build argument here: a
# variable FROM would hide the reference from Dependabot and defeat digest
# updates. Configure mirrors in the Docker daemon (/etc/docker/daemon.json,
# "registry-mirrors") instead; pulls by digest use the mirror normally.
FROM alpine:3.24@sha256:f59abe656b692d901e184be3445e084786602108599d2a51d229c0f5a48c71bf

# Optional: use a Chinese APK mirror (e.g., mirrors.tuna.tsinghua.edu.cn)
ARG APK_MIRROR
RUN if [ -n "$APK_MIRROR" ]; then \
        sed -i "s|dl-cdn.alpinelinux.org|${APK_MIRROR}|g" /etc/apk/repositories; \
    fi

# Install required packages for the base version
RUN apk add --no-cache \
        texlive \
        texlive-luatex \
        texlive-xetex \
        texmf-dist \
        texmf-dist-latex \
        texmf-dist-latexrecommended \
        texmf-dist-plaingeneric \
        texmf-dist-luatex \
        biber \
        make

# Copy the tex-fmt binary for the target platform. tex-fmt publishes an
# x86_64-alpine build but no aarch64-alpine build, so arm64 skips it.
ARG TEX_FMT_DIR=alpine
ARG TARGETARCH
COPY ${TEX_FMT_DIR}/ /tmp/tex-fmt/
RUN case "${TARGETARCH}" in \
        amd64) cp /tmp/tex-fmt/amd64/tex-fmt /usr/local/bin/tex-fmt \
               && chmod +x /usr/local/bin/tex-fmt ;; \
        arm64) echo "tex-fmt has no aarch64-alpine build; skipping" ;; \
        *) echo "Unsupported Alpine architecture: ${TARGETARCH}" >&2; exit 1 ;; \
    esac \
    && rm -rf /tmp/tex-fmt

# OCI image metadata. CI overrides version and revision.
ARG VERSION=dev
ARG REVISION=unknown
LABEL org.opencontainers.image.title="oaklight/texlive alpine-base" \
      org.opencontainers.image.description="Alpine-based TeX Live base image (LuaTeX, XeTeX, biber)" \
      org.opencontainers.image.source="https://github.com/Oaklight/texlive" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${REVISION}"
# base.name is omitted: the FROM tag is the source of truth.
